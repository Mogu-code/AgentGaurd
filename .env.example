# Copy this file to .env and fill in real values. NEVER commit .env.

# Razorpay TEST MODE credentials only. If left blank, the system automatically
# falls back to MockRazorpayClient (see backend/app/razorpay_client.py) so the
# whole pipeline still runs without a Razorpay account.
RAZORPAY_MODE=mock
RAZORPAY_KEY_ID=your_test_key_id_here
RAZORPAY_KEY_SECRET=your_test_key_secret_here




# Optional: only needed if USE_LLM is switched on in intent_extraction.py
ANTHROPIC_API_KEY=
